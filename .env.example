# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Naver Search Ads API
NAVER_ADS_API_KEY=your_naver_ads_api_key
NAVER_ADS_SECRET_KEY=your_naver_ads_secret_key
NAVER_ADS_CUSTOMER_ID=your_naver_customer_id

# Kakao Ads API
KAKAO_ADS_ACCESS_TOKEN=your_kakao_ads_access_token
KAKAO_ADS_ACCOUNT_ID=your_kakao_ads_account_id

# Coupang Ads API
COUPANG_ADS_ACCESS_KEY=your_coupang_ads_access_key
COUPANG_ADS_SECRET_KEY=your_coupang_ads_secret_key

# Meta (Facebook/Instagram) Ads API
META_ADS_ACCESS_TOKEN=your_meta_ads_access_token
META_ADS_ACCOUNT_ID=your_meta_ads_account_id
META_ADS_APP_ID=your_meta_app_id
META_ADS_APP_SECRET=your_meta_app_secret

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_developer_token
GOOGLE_ADS_CLIENT_ID=your_google_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_google_customer_id
